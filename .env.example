# Copy to .env for local development. Hosts set these as environment variables instead (PRD 5.13).
DATABASE_URL=postgresql://citemark:citemark@localhost:54320/citemark
ANTHROPIC_API_KEY=
# Only if the key isn't scoped to a workspace: the workspace's ID (wrkspc_...)
ANTHROPIC_WORKSPACE_ID=
VOYAGE_API_KEY=
SECRET_KEY=
PUBLIC_BASE_URL=
# Handoff (Phase 2): Zendesk, or a webhook
ZENDESK_SUBDOMAIN=
ZENDESK_EMAIL=
ZENDESK_API_TOKEN=
WEBHOOK_URL=
WEBHOOK_SECRET=
# Set only during a password recovery
ADMIN_RESET_TOKEN=

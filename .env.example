# Copy to .env for local development. Hosts set these as environment variables instead (PRD 5.13).
DATABASE_URL=postgresql://citemark:citemark@localhost:54320/citemark
# The abuse set's own database, holding its planted articles. Reports read the abuse gate there.
ABUSE_DATABASE_URL=
# The name reports are prepared and signed with
BUILDER_NAME=
ANTHROPIC_API_KEY=
# Only if the key isn't scoped to a workspace: the workspace's ID (wrkspc_...)
ANTHROPIC_WORKSPACE_ID=
VOYAGE_API_KEY=
SECRET_KEY=
PUBLIC_BASE_URL=
# Handoff (Phase 2): Zendesk, or a webhook
ZENDESK_SUBDOMAIN=
ZENDESK_EMAIL=
ZENDESK_API_TOKEN=
WEBHOOK_URL=
WEBHOOK_SECRET=
# Set only during a password recovery
ADMIN_RESET_TOKEN=
# The header the host's proxy puts the visitor's address in: CF-Connecting-IP on Render.
# Left empty, the connection's own address is used, which is right only without a proxy.
CLIENT_IP_HEADER=
# The public demo page, served at / once DEMO_COMPANY is set (PRD 8.2)
DEMO_COMPANY=
DEMO_MODEL=claude-haiku-5-5
# The audit listing on Upwork (an https:// address), and its price as the listing shows it
DEMO_AUDIT_URL=
DEMO_AUDIT_PRICE=
# The published results file, once the decision runs exist
DEMO_RESULTS=

              "content": [
                {
                  "type": "text",
                  "text": "Starring messages is a good way to keep track of important messages, such as tasks you need to go back to or documents you reference often."
                },
                {
                  "type": "text",
                  "text": "Desktop/Web: Hover over a message to reveal three icons on the right. Click the star icon."
                },
                {
                  "type": "text",
                  "text": "Mobile: Press and hold a message until the long-press menu appears. Tap Star message."
                },
                {
                  "type": "text",
                  "text": "Tip: You can unstar a message using the same instructions used to star it."
                }
              ],
